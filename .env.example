# Copy to .env for local development
DB_PASSWORD=library
DB_PORT=5433
DATABASE_URL=postgres://library:library@localhost:5433/library
# Absolute or repo-relative path; defaults to ./library
LIBRARY_DIR=./library
# Where the `lib` CLI finds the web app's API
LIB_API_URL=http://localhost:3000
# Deployment (docker compose)
LIBRARY_HOST_DIR=/srv/study-library/library
BACKUP_HOST_DIR=/srv/study-library/backups
BACKUP_KEEP_DAYS=14
# Bind the app to one interface, e.g. your LAN or Tailscale IP. 0.0.0.0 = all interfaces.
APP_BIND=0.0.0.0
# Optional: origin printed in links by the API/CLI (e.g. http://homeserver:3000)
PUBLIC_URL=
