{
  "name": "study-library",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @study/web build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env packages/core/src/db/migrate-cli.ts",
    "db:up": "docker compose up -d db",
    "dev": "pnpm --filter @study/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lib": "tsx --env-file-if-exists=.env packages/cli/src/index.ts",
    "lint": "eslint .",
    "lint:dupes": "jscpd apps packages",
    "lint:fix": "eslint --fix .",
    "start": "pnpm --filter @study/web start",
    "study": "tsx --env-file-if-exists=.env packages/cli/src/index.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@study/anchoring": "workspace:*",
    "@study/core": "workspace:*",
    "@study/ingest": "workspace:*"
  }
}
